# UNS Smart Maintenance - Environment Configuration
# Copy this file to .env.local and update with your actual values

# Supabase Configuration (Application Data)
# Get these from your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# TimescaleDB Cloud Configuration (Time-Series Data)
# Get these from your TimescaleDB Cloud dashboard
TIMESCALEDB_HOST=your-timescale-host.com
TIMESCALEDB_PORT=5432
TIMESCALEDB_DATABASE=your-database-name
TIMESCALEDB_USERNAME=your-username
TIMESCALEDB_PASSWORD=your-password
TIMESCALEDB_URL=postgresql://your-username:your-password@your-timescale-host.com:5432/your-database-name

# MQTT Configuration for CNC Machine Data
# Configure these with your EMQX Cloud broker details

# EMQX Cloud Basic Configuration
MQTT_BROKER_HOST=your-broker-id.emqxsl.com
MQTT_BROKER_PORT=8883
MQTT_PROTOCOL=mqtts
MQTT_USERNAME=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password

# WebSocket Configuration for Dashboard
NEXT_PUBLIC_MQTT_WS_HOST=your-broker-id.emqxsl.com
NEXT_PUBLIC_MQTT_WS_PORT=8084
NEXT_PUBLIC_MQTT_WS_PATH=/mqtt
NEXT_PUBLIC_MQTT_WS_USERNAME=dashboard-user
NEXT_PUBLIC_MQTT_WS_PASSWORD=dashboard-password

# TLS/SSL Configuration
MQTT_TLS_ENABLED=true
MQTT_TLS_REJECT_UNAUTHORIZED=true
MQTT_CA_CERT_PATH=
MQTT_CLIENT_CERT_PATH=
MQTT_CLIENT_KEY_PATH=

# Connection Settings
MQTT_KEEPALIVE=60
MQTT_CLEAN_SESSION=true
MQTT_RECONNECT_PERIOD=1000
MQTT_CONNECT_TIMEOUT=30000

# QoS Settings for different data types
MQTT_QOS_TELEMETRY=0
MQTT_QOS_STATUS=1
MQTT_QOS_ALARMS=2

# Optional: Redis Configuration for MQTT-to-Web Bridge
# Configure if using Upstash Redis for data caching
REDIS_URL=redis://your-redis-host:6379
REDIS_TOKEN=your-redis-token

# Development Settings
NODE_ENV=development