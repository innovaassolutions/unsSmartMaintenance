// Prisma Schema for UNS Smart Maintenance System
// Hybrid Architecture: Supabase (app data) + TimescaleDB (time-series data)

generator client {
  provider = "prisma-client-js"
}

// Primary database - Supabase (PostgreSQL)
// Note: TimescaleDB integration will be handled through separate connection
datasource db {
  provider = "postgresql"
  url      = env("SUPABASE_DATABASE_URL")
}

// ==============================================
// SUPABASE MODELS (Application Data)
// ==============================================

// UNS Topic Registry for standardized namespace management
model TopicRegistry {
  id              String   @id @default(uuid()) @db.Uuid
  topic_path      String   @unique @db.VarChar(500)
  topic_type      String   @db.VarChar(20) // descriptive, functional, informational, ad_hoc
  enterprise      String   @db.VarChar(50)
  site            String   @db.VarChar(50)
  area            String   @db.VarChar(50)
  work_cell       String   @db.VarChar(50)
  work_unit       String   @db.VarChar(50)
  data_category   String   @db.VarChar(50)
  metric_name     String   @db.VarChar(100)
  description     String?  @db.Text
  unit            String?  @db.VarChar(20)
  data_type       String   @db.VarChar(20) // number, string, boolean, object
  min_value       Decimal? @db.Decimal(15, 6)
  max_value       Decimal? @db.Decimal(15, 6)
  schema_definition Json?
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz
  updated_at      DateTime @updatedAt @db.Timestamptz

  // Relations
  cnc_machine CNCMachine? @relation(fields: [work_unit], references: [machine_id])

  @@map("topic_registry")
  @@index([topic_path])
  @@index([enterprise, site, area, work_cell, work_unit])
  @@index([topic_type])
  @@index([is_active])
}

// CNC Machines for UNS hierarchy work units
model CNCMachine {
  id                String   @id @default(uuid()) @db.Uuid
  machine_id        String   @unique @db.VarChar(20)
  display_name      String   @db.VarChar(100)
  manufacturer      String?  @db.VarChar(50)
  model             String?  @db.VarChar(50)
  enterprise        String   @db.VarChar(50)
  site              String   @db.VarChar(50)
  area              String   @db.VarChar(50)
  work_cell         String   @db.VarChar(50)
  installation_date DateTime? @db.Date
  operational_status String  @default("operational") @db.VarChar(20) // operational, maintenance, offline, error
  capabilities      Json?
  specifications    Json?
  created_at        DateTime @default(now()) @db.Timestamptz
  updated_at        DateTime @updatedAt @db.Timestamptz
  
  // Pipeline integration fields
  last_data_received    DateTime? @db.Timestamptz
  data_quality_score    Decimal?  @default(1.0) @db.Decimal(3,2)
  total_messages_received BigInt  @default(0)
  pipeline_status       String   @default("unknown") @db.VarChar(20)

  // Relations
  topic_registries TopicRegistry[]
  sensor_readings  SensorReading[]
  validation_errors DataValidationError[]

  @@map("cnc_machines")
  @@index([machine_id])
  @@index([enterprise, site, area, work_cell])
  @@index([operational_status])
}

// Topic Subscriptions for role-based access control
model TopicSubscription {
  id            String   @id @default(uuid()) @db.Uuid
  user_role     String   @db.VarChar(50) // factory_manager, production_manager, maintenance_technician, executive
  topic_pattern String   @db.Text
  access_level  String   @db.VarChar(20) // read, write, admin
  description   String?  @db.Text
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now()) @db.Timestamptz

  @@map("topic_subscriptions")
  @@index([user_role])
  @@index([is_active])
}

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  description String?  @db.Text
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @updatedAt @db.Timestamptz

  // Relations
  users    UserProfile[]
  machines MachineDefinition[]

  @@map("organizations")
}

model UserProfile {
  id              String   @id @default(uuid()) @db.Uuid
  user_id         String   @unique @db.Uuid
  organization_id String   @db.Uuid
  full_name       String   @db.VarChar(100)
  role            String   @db.VarChar(50)
  department      String?  @db.VarChar(50)
  created_at      DateTime @default(now()) @db.Timestamptz
  updated_at      DateTime @updatedAt @db.Timestamptz

  // Relations
  organization Organization @relation(fields: [organization_id], references: [id])

  @@map("user_profiles")
}

model MachineDefinition {
  id              String   @id @default(uuid()) @db.Uuid
  organization_id String   @db.Uuid
  machine_name    String   @db.VarChar(100)
  machine_type    String   @db.VarChar(50)
  manufacturer    String?  @db.VarChar(100)
  model           String?  @db.VarChar(100)
  location        String?  @db.VarChar(200)
  installation_date DateTime? @db.Date
  created_at      DateTime @default(now()) @db.Timestamptz
  updated_at      DateTime @updatedAt @db.Timestamptz

  // Relations
  organization Organization @relation(fields: [organization_id], references: [id])
  sensors      Sensor[]

  @@map("machine_definitions")
}

model MaintenanceCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  description String?  @db.Text
  created_at  DateTime @default(now()) @db.Timestamptz

  @@map("maintenance_categories")
}

model Sensor {
  id           String   @id @default(uuid()) @db.Uuid
  machine_id   String   @db.Uuid
  sensor_name  String   @db.VarChar(100)
  sensor_type  String   @db.VarChar(50)
  mqtt_topic   String   @db.VarChar(200)
  unit         String?  @db.VarChar(20)
  min_value    Decimal? @db.Decimal(15, 6)
  max_value    Decimal? @db.Decimal(15, 6)
  calibration_offset Decimal? @db.Decimal(15, 6)
  calibration_factor Decimal? @db.Decimal(15, 6)
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz
  updated_at   DateTime @updatedAt @db.Timestamptz

  // Relations
  machine MachineDefinition @relation(fields: [machine_id], references: [id])

  @@map("sensors")
}

// ==============================================
// TIME-SERIES DATA MODELS 
// Note: These models represent the structure for TimescaleDB integration
// They will be managed through separate database connections
// ==============================================

model SensorReading {
  id             BigInt    @id @default(autoincrement())
  machineId      String    @map("machine_id") @db.Uuid
  sensorType     String    @map("sensor_type") @db.VarChar(50)
  topicPath      String    @map("topic_path")
  valueNumeric   Decimal?  @map("value_numeric") @db.Decimal(12,4)
  valueText      String?   @map("value_text")
  valueBoolean   Boolean?  @map("value_boolean")
  unit           String?   @db.VarChar(20)
  timestamp      DateTime  @default(now())
  qualityCode    Int?      @map("quality_code") @default(192)
  createdAt      DateTime  @map("created_at") @default(now())
  
  machine        CNCMachine @relation(fields: [machineId], references: [id])
  
  @@index([machineId, timestamp(sort: Desc)])
  @@index([sensorType, timestamp(sort: Desc)])
  @@index([topicPath, timestamp(sort: Desc)])
  @@map("sensor_readings")
}

model MachineStatus {
  id         String   @id @default(uuid()) @db.Uuid
  machine_id String   @db.Uuid
  timestamp  DateTime @default(now()) @db.Timestamptz
  status     String   @db.VarChar(50) // running, idle, maintenance, fault, offline
  uptime_seconds Int?
  cycle_count    Int?
  efficiency_percent Decimal? @db.Decimal(5, 2)
  metadata   Json?

  @@map("machine_status")
  // Note: This table should be created in TimescaleDB for optimal time-series performance
  @@index([machine_id, timestamp])
  @@index([timestamp])
}

model Alert {
  id           String   @id @default(uuid()) @db.Uuid
  machine_id   String   @db.Uuid
  sensor_id    String?  @db.Uuid
  timestamp    DateTime @default(now()) @db.Timestamptz
  alert_type   String   @db.VarChar(50) // warning, critical, info
  severity     Int      // 1-5 scale
  title        String   @db.VarChar(200)
  description  String?  @db.Text
  acknowledged Boolean  @default(false)
  acknowledged_by String? @db.Uuid
  acknowledged_at DateTime? @db.Timestamptz
  resolved     Boolean  @default(false)
  resolved_at  DateTime? @db.Timestamptz
  metadata     Json?

  @@map("alerts")
  // Note: This table should be created in TimescaleDB for optimal time-series performance
  @@index([machine_id, timestamp])
  @@index([timestamp])
  @@index([alert_type, resolved])
}

model MaintenanceRecord {
  id                String   @id @default(uuid()) @db.Uuid
  machine_id        String   @db.Uuid
  category_id       String?  @db.Uuid
  scheduled_date    DateTime @db.Timestamptz
  completed_date    DateTime? @db.Timestamptz
  maintenance_type  String   @db.VarChar(50) // preventive, corrective, predictive
  description       String   @db.Text
  performed_by      String?  @db.Uuid
  duration_minutes  Int?
  cost              Decimal? @db.Decimal(10, 2)
  notes             String?  @db.Text
  status            String   @db.VarChar(50) // scheduled, in_progress, completed, cancelled
  created_at        DateTime @default(now()) @db.Timestamptz
  updated_at        DateTime @updatedAt @db.Timestamptz

  @@map("maintenance_records")
  // Note: This table should be created in TimescaleDB for optimal time-series performance
  @@index([machine_id, scheduled_date])
  @@index([maintenance_type, status])
}

// ==============================================
// PIPELINE MODELS (Added for MQTT to Supabase Pipeline)
// ==============================================

model PipelineMetric {
  id          BigInt    @id @default(autoincrement())
  metricType  String    @map("metric_type") @db.VarChar(50)
  metricName  String    @map("metric_name") @db.VarChar(100)
  value       Decimal   @db.Decimal(10,4)
  unit        String?   @db.VarChar(20)
  tags        Json?
  timestamp   DateTime  @default(now())
  
  @@index([metricType, timestamp(sort: Desc)])
  @@index([metricName, timestamp(sort: Desc)])
  @@map("pipeline_metrics")
}

model DataValidationError {
  id            BigInt    @id @default(autoincrement())
  machineId     String?   @map("machine_id") @db.Uuid
  topicPath     String    @map("topic_path")
  errorType     String    @map("error_type") @db.VarChar(50)
  errorMessage  String    @map("error_message")
  rawPayload    Json?     @map("raw_payload")
  attemptedAt   DateTime  @map("attempted_at") @default(now())
  
  machine       CNCMachine? @relation(fields: [machineId], references: [id])
  
  @@index([machineId, errorType, attemptedAt(sort: Desc)])
  @@map("data_validation_errors")
}